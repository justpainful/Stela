From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: justpainful <143810293+justpainful@users.noreply.github.com>
Date: Wed, 18 Nov 2026 10:41:50 +0000
Subject: [PATCH] perf(nouveau): hold the GPU at its highest P-state while
 GSP-RM's rounds run, boosting it each second for 3 s with the internal
 control kernel RM sends for PERF_BOOST, where RM's own policy fell to P8
 between a desktop's short bursts of work and ran each at idle clocks

---
 .../drm/nouveau/include/nvkm/core/counts.h    |  7 ++++
 .../gpu/drm/nouveau/include/nvkm/subdev/gsp.h |  2 +
 .../nvkm/subdev/gsp/rm/r535/nvrm/perf.h       | 20 ++++++++++
 .../nouveau/nvkm/subdev/gsp/rm/r535/perf.c    | 37 +++++++++++++++++++
 4 files changed, 66 insertions(+)

diff --git a/drivers/gpu/drm/nouveau/include/nvkm/core/counts.h b/drivers/gpu/drm/nouveau/include/nvkm/core/counts.h
index 2bfd1f058e25244f6b0287d41a2055239c935a4e..1e6c1e8fa9ac190878ac2d827ca2955008fc31f5 100644
--- a/drivers/gpu/drm/nouveau/include/nvkm/core/counts.h
+++ b/drivers/gpu/drm/nouveau/include/nvkm/core/counts.h
@@ -50,6 +50,13 @@ struct nvkm_perf_report {
 	u32 link_control;
 	u32 link_speeds;
 	u32 link_cap;
+	/*
+	 * The boosts to the highest P-state RM accepted since a host last took
+	 * them, which it takes with an atomic swap, and the errno of the boost
+	 * control RM refused, after which it is asked no more.
+	 */
+	u32 boosts;
+	s32 boost_status;
 };
 
 extern struct nvkm_perf_report nvkm_perf;
diff --git a/drivers/gpu/drm/nouveau/include/nvkm/subdev/gsp.h b/drivers/gpu/drm/nouveau/include/nvkm/subdev/gsp.h
index a0eb3a391307064df7114d9d5583fd5da4bd4c34..bd5561af133a3da2407dbdc4ea2848d1ebda02e4 100644
--- a/drivers/gpu/drm/nouveau/include/nvkm/subdev/gsp.h
+++ b/drivers/gpu/drm/nouveau/include/nvkm/subdev/gsp.h
@@ -229,6 +229,8 @@ struct nvkm_gsp {
 		bool armed;
 		/* RM refused the control: it is asked no more. */
 		bool pstate_off;
+		/* RM refused the boost: it is asked for none again. */
+		bool boost_off;
 	} perf;
 
 	/* Internal GSP-RM control handles. */
diff --git a/drivers/gpu/drm/nouveau/nvkm/subdev/gsp/rm/r535/nvrm/perf.h b/drivers/gpu/drm/nouveau/nvkm/subdev/gsp/rm/r535/nvrm/perf.h
index 978a1f494d9f42a2fe696701dd9dfb60e57c7ded..30bfa7372d4235ff790d8c42e15c382924655777 100644
--- a/drivers/gpu/drm/nouveau/nvkm/subdev/gsp/rm/r535/nvrm/perf.h
+++ b/drivers/gpu/drm/nouveau/nvkm/subdev/gsp/rm/r535/nvrm/perf.h
@@ -17,4 +17,24 @@ typedef struct NV2080_CTRL_PERF_GET_CURRENT_PSTATE_PARAMS {
     NvU32 currPstate;
 } NV2080_CTRL_PERF_GET_CURRENT_PSTATE_PARAMS;
 
+/*
+ * Excerpt of RM headers from https://github.com/NVIDIA/open-gpu-kernel-modules/tree/570.144:
+ * ctrl2080perf.h's boost flags and ctrl2080internal.h's control that kernel RM's
+ * kperfBoostSet() sends physical RM for a client's NV2080_CTRL_CMD_PERF_BOOST.
+ */
+
+#define NV2080_CTRL_PERF_BOOST_FLAGS_CMD                1:0
+#define NV2080_CTRL_PERF_BOOST_FLAGS_CMD_CLEAR        (0x00000000)
+#define NV2080_CTRL_PERF_BOOST_FLAGS_CMD_BOOST_1LEVEL (0x00000001)
+#define NV2080_CTRL_PERF_BOOST_FLAGS_CMD_BOOST_TO_MAX (0x00000002)
+
+#define NV2080_CTRL_PERF_BOOST_DURATION_MAX           3600 //The duration can be specified up to 1 hour
+
+#define NV2080_CTRL_CMD_INTERNAL_PERF_BOOST_SET_2X (0x20800a9a) /* finn: Evaluated from "(FINN_NV20_SUBDEVICE_0_INTERNAL_INTERFACE_ID << 8) | NV2080_CTRL_INTERNAL_PERF_BOOST_SET_PARAMS_2X_MESSAGE_ID" */
+
+typedef struct NV2080_CTRL_INTERNAL_PERF_BOOST_SET_PARAMS_2X {
+    NvBool flags;
+    NvU32  duration;
+} NV2080_CTRL_INTERNAL_PERF_BOOST_SET_PARAMS_2X;
+
 #endif
diff --git a/drivers/gpu/drm/nouveau/nvkm/subdev/gsp/rm/r535/perf.c b/drivers/gpu/drm/nouveau/nvkm/subdev/gsp/rm/r535/perf.c
index 8722a6587a516678e1952628e85956d2f94f4fe3..69b55dd7d95e775c399b435bca14025ee96a3830 100644
--- a/drivers/gpu/drm/nouveau/nvkm/subdev/gsp/rm/r535/perf.c
+++ b/drivers/gpu/drm/nouveau/nvkm/subdev/gsp/rm/r535/perf.c
@@ -15,6 +15,15 @@
  * Each round also reads the GPU's own PCIe Link Status and Link Control, as
  * RM moves the link speed with the P-state: a link that stays slow while RM
  * runs at P0 limits every transfer from system memory.
+ *
+ * Each round then asks RM to boost the GPU to its highest P-state for
+ * R535_GSP_PERF_BOOST_S, with the internal control NVIDIA's kernel RM sends
+ * physical RM for a client's NV2080_CTRL_CMD_PERF_BOOST (kperfBoostSet()).
+ * Left to its own policy RM fell to P8 between a desktop's short bursts of
+ * work, so each burst ran at idle clocks (P8 in nearly every report on an
+ * RTX 4070 SUPER). The boost outlasts the round's period, so it holds while
+ * the rounds go on and lapses within R535_GSP_PERF_BOOST_S once they stop,
+ * with no state left behind in RM. A refusal is kept like the P-state's.
  */
 #include <rm/rpc.h>
 
@@ -27,6 +36,9 @@
 
 #define R535_GSP_PERF_MS 1000
 
+/* Long enough that a late round finds the last boost still held. */
+#define R535_GSP_PERF_BOOST_S 3
+
 struct nvkm_perf_report nvkm_perf;
 
 /* A control RM refused, or answered implausibly: asked no more. */
@@ -88,6 +100,29 @@ r535_gsp_perf_pstate(struct nvkm_gsp *gsp)
 	__atomic_fetch_or(&nvkm_perf.pstates, pstate, __ATOMIC_RELAXED);
 }
 
+/* Holds the GPU at its highest P-state for the next R535_GSP_PERF_BOOST_S. */
+static void
+r535_gsp_perf_boost(struct nvkm_gsp *gsp)
+{
+	struct nvkm_gsp_object *subdevice = &gsp->internal.device.subdevice;
+	NV2080_CTRL_INTERNAL_PERF_BOOST_SET_PARAMS_2X *ctrl;
+
+	ctrl = nvkm_gsp_rm_ctrl_get(subdevice, NV2080_CTRL_CMD_INTERNAL_PERF_BOOST_SET_2X,
+				    sizeof(*ctrl));
+	if (IS_ERR(ctrl)) {
+		r535_gsp_perf_refused(&gsp->perf.boost_off, &nvkm_perf.boost_status,
+				      PTR_ERR(ctrl));
+		return;
+	}
+	ctrl->flags = NV2080_CTRL_PERF_BOOST_FLAGS_CMD_BOOST_TO_MAX;
+	ctrl->duration = R535_GSP_PERF_BOOST_S;
+	if (r535_gsp_perf_push(subdevice, (void **)&ctrl, sizeof(*ctrl),
+			       &gsp->perf.boost_off, &nvkm_perf.boost_status))
+		return;
+	nvkm_gsp_rm_ctrl_done(subdevice, ctrl);
+	__atomic_fetch_add(&nvkm_perf.boosts, 1, __ATOMIC_RELAXED);
+}
+
 /*
  * The GPU's PCIe link as its own capability reports it, as Linux's
  * pcie_capability_read_word() reads it; a function with no PCIe capability
@@ -130,6 +165,8 @@ r535_gsp_perf_work(struct work_struct *work)
 		return;
 
 	r535_gsp_perf_link(gsp);
+	if (!gsp->perf.boost_off)
+		r535_gsp_perf_boost(gsp);
 	if (!gsp->perf.pstate_off)
 		r535_gsp_perf_pstate(gsp);
 	__atomic_fetch_add(&nvkm_perf.rounds, 1, __ATOMIC_RELAXED);
